# Modifier key (Super / Windows)
set $mod Mod4

# Applications
set $term alacritty
set $menu wofi --show drun

# D-Bus & systemd user session activation
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Ensure Waybar starts with Sway
exec waybar

# Bluetooth
exec --no-startup-id blueman-applet

# mako
exec --no-startup-id mako

# Gruvbox Dark Palette
set $bg      #282828
set $red     #cc241d
set $green   #98971a
set $yellow  #d79921
set $blue    #458588
set $purple  #b16286
set $aqua    #689d6a
set $gray    #a89984
set $darkgray #1d2021

# Window borders & colors
# class                 border  backgr  text    indicator child_border
client.focused          $yellow $yellow $darkgray $yellow  $yellow
client.focused_inactive $darkgray $darkgray $gray $darkgray $darkgray
client.unfocused        $darkgray $darkgray $gray $darkgray $darkgray
client.urgent           $red    $red    $darkgray $red     $red

default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 2

# Wallpaper
output * bg ~/dotfiles/wallpapers/wall.jpg fill

# Core Keybindings
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+c exec code
bindsym $mod+b exec firefox
bindsym $mod+e exec nautilus
bindsym $mod+x kill
bindsym $mod+space exec swaymsg input type:keyboard xkb_switch_layout next
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exit

# Screenshot keybindings
bindsym --to-code Print exec grim -g "$(slurp)" - | tee ~/Pictures/Screenshots/screenshot_$(date +'%Y-%m-%d_%H%M%S').png | wl-copy

# Screen Lock
bindsym --to-code $mod+Escape exec ~/.config/sway/lock.sh

### Audio Controls (via pamixer)
# Dedicated media keys
bindsym XF86AudioMute exec pamixer -t
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioRaiseVolume exec pamixer -i 5

# Direct F1, F2, F3 bindings (uncomment if you don't use Fn key)
# bindsym F1 exec pamixer -t
# bindsym F2 exec pamixer -d 10
# bindsym F3 exec pamixer -i 10

# Navigation
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

### Keyboard Layout Configuration
input "type:keyboard" {
    xkb_layout "us,ara"
    xkb_variant ","
}

### Touchpad Configuration
input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}