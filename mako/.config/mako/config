# --- Layout & Geometry ---
max-history=10
sort=-time
width=360
height=150
margin=14
padding=12
border-size=2
border-radius=8
icons=1
max-icon-size=48
default-timeout=3000
font=monospace 10

# --- Gruvbox Dark Palette ---
# Background: #282828 (dark0)
# Foreground: #ebdbb2 (light1)
# Border:     #504945 (gray)
background-color=#282828
text-color=#ebdbb2
border-color=#504945

# --- Urgency Levels ---
[urgency=low]
border-color=#3c3836

[urgency=normal]
border-color=#bdae93

[urgency=high]
# Border: #fb4934 (Gruvbox Red)
border-color=#fb4934
text-color=#fbf1c7